✅ 🔷 EXERCICE 4 — 

🔹 Code

clear; clc;

x = linspace(-pi, pi, 500);

% Fonction f
function y = f(x)
  y = abs(x);
endfunction

% Somme partielle Sp
function y = Sp(x, p)
  y = pi/2;
  for k = 0:p
    y = y - (4/pi) * cos((2*k+1)*x) / (2*k+1)^2;
  endfor
endfunction

% --- 1. Tracés ---
figure;
plot(x, f(x), 'k', 'linewidth', 2); hold on;
plot(x, Sp(x,0));
plot(x, Sp(x,3));
plot(x, Sp(x,5));
legend('f','S0','S3','S5');
title('Exo 4');

% --- 2. Erreurs ---
figure;
plot(x, f(x)-Sp(x,0)); hold on;
plot(x, f(x)-Sp(x,3));
plot(x, f(x)-Sp(x,5));
legend('f-S0','f-S3','f-S5');
title('Erreurs');

% --- 3. grands p ---
figure;
plot(x, f(x), 'k', 'linewidth',2); hold on;
plot(x, Sp(x,20));
plot(x, Sp(x,50));
plot(x, Sp(x,100));
legend('f','S20','S50','S100');


