✅ 🔷 EXERCICE 6 — fonction mixte

f(x)=
\begin{cases}
0 & x \le 0 \\
x & x > 0
\end{cases}


---

🔹 Code

clear; clc;

x = linspace(-pi, pi, 500);

function y = f(x)
  y = (x > 0).*x;
endfunction

function y = Sn(x, n)
  y = pi/4;
  for k = 1:n
    if mod(k,2)==1
      ak = -2/(pi*k^2);
    else
      ak = 0;
    endif
    
    bk = (-1)^k / k;
    
    y = y + ak*cos(k*x) + bk*sin(k*x);
  endfor
endfunction

% 1. tracé
figure;
plot(x, f(x),'k','linewidth',2); hold on;
plot(x, Sn(x,1));
plot(x, Sn(x,3));
plot(x, Sn(x,5));
legend('f','S1','S3','S5');

% 2. erreurs
figure;
plot(x, f(x)-Sn(x,1)); hold on;
plot(x, f(x)-Sn(x,3));
plot(x, f(x)-Sn(x,5));

% 3. grands n
figure;
plot(x, f(x),'k','linewidth',2); hold on;
plot(x, Sn(x,50));
plot(x, Sn(x,100));
plot(x, Sn(x,150));


